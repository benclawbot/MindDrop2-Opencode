# MindDrop environment configuration.
# Copy this file to .env.local for local dev. .env.local is gitignored.
#
# DEPLOYMENT: For Vercel, run:
#   vercel env add MINIMAX_API_KEY production
#   vercel env add MINIMAX_API_KEY preview
#   vercel env add MINIMAX_API_KEY development
# then paste the key when prompted. The key stays server-side (never bundled).

# Required: MiniMax API key. Read by the serverless proxy in api/minimax.ts.
# Optional: override the MiniMax API base URL (default shown).
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Optional: override the model used for chat completions.
MINIMAX_MODEL=MiniMax-M2.7

# Optional: restrict CORS to your domain in production.
# Example: https://mind-drop2-opencode.vercel.app
ALLOWED_ORIGIN=*